    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "swiper": "^14.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
